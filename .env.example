# Resend — https://resend.com/api-keys
# Server-side only. Never prefix with VITE_, or it is bundled into the client.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain verified at https://resend.com/domains.
# Before the domain is verified, use: Guardian Care <onboarding@resend.dev>
# (resend.dev only delivers to the Resend account owner's own address.)
ENQUIRY_FROM=Guardian Care <noreply@guardiancsre.com>

# Where enquiries land. Defaults to CONTACT.email if unset.
ENQUIRY_TO=hi@guardiancsre.com
