# Resend — https://resend.com/api-keys
# Server-side only. Never prefix with VITE_, or it is bundled into the client
# and anyone can read it in the browser.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Who the enquiry appears to come from.
#
# This CANNOT be a Gmail address. Resend will only send from a domain whose DNS
# you control and have verified, and nobody controls gmail.com. Use an address
# on guardiancare.com and verify that domain at https://resend.com/domains,
# adding the records it gives you in GoDaddy.
#
# Until the domain is verified, leave this unset. The fallback is Resend's
# shared test sender, which delivers only to the address your Resend account is
# registered with — so if you sign up as Greenguardiansolar@gmail.com, enquiries
# reach you straight away with no DNS at all.
ENQUIRY_FROM=Guardian Care <noreply@guardiancare.com>

# Where enquiries land. The company inbox, not the address printed on the site.
ENQUIRY_TO=Greenguardiansolar@gmail.com

# ---- Google Calendar (real availability) -------------------------------
# Without these the booking form still works; it just offers every weekday
# slot and labels the times "provisional" instead of reading the diary.
#
# Google Cloud console -> enable the Google Calendar API -> create a service
# account -> add a JSON key.
GOOGLE_SA_EMAIL=booking-reader@your-project.iam.gserviceaccount.com

# The "private_key" field from that JSON file. Pasting it into Vercel with
# literal \n sequences is fine - both forms are handled.
GOOGLE_SA_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

GOOGLE_CALENDAR_ID=hi@guardiancare.com

# Impersonation, and it is OPTIONAL.
#
# Preferred: leave this unset and share the calendar with GOOGLE_SA_EMAIL
# instead (Calendar -> Settings for my calendars -> Share with specific people
# -> "See only free/busy"). Works on Workspace and on personal accounts, needs
# no admin rights, and grants read of exactly one calendar.
#
# Alternative: Workspace domain-wide delegation. An admin registers the service
# account's numeric Client ID under Admin -> Security -> Access and data
# control -> API controls -> Domain-wide delegation with the scope
# https://www.googleapis.com/auth/calendar.readonly. Then set this to the
# mailbox to act as. That grant lets the service account impersonate any user
# in the domain, so it is more authority than reading one diary needs.
#
# Setting it WITHOUT the delegation grant makes Google refuse the token.
# GOOGLE_SA_SUBJECT=hi@guardiancare.com
